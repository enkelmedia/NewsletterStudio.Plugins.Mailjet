<Project>
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>1701;1702;1591;1587;1570;1574;NU1507;NU1903;NU1902</NoWarn>
    <Configurations>Debug;Release;DebugNoFrontendBuild</Configurations>
    <!-- Generic Package Info-->
    <AssemblyVersion>17.0.0</AssemblyVersion>
    <Version>17.0.0</Version>
    <PackageVersion>17.0.0</PackageVersion>
    <InformationalVersion>17.0.0</InformationalVersion>
    <Authors>Enkel Media Stockholm AB</Authors>
    <Copyright>Copyright (c) Enkel Media Stockholm AB</Copyright>
    <PackageProjectUrl>https://www.newsletterstudio.org/</PackageProjectUrl>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <EnableRoslynAnalyzers>false</EnableRoslynAnalyzers>
  </PropertyGroup>
</Project>
