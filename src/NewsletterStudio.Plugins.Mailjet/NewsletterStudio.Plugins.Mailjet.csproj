<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <ContentTargetFolders>.</ContentTargetFolders>
    <PackageId>NewsletterStudio.Plugins.Mailjet</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://www.newsletterstudio.org</PackageProjectUrl>
    <PackageTags>umbraco umbraco-marketplace newsletter-studio transactional mailjet</PackageTags>
    <RepositoryUrl>https://github.com/enkelmedia/NewsletterStudio.Plugins.Mailjet</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <Description>Plugin for Newsletter Studio to send emails via the Mailjet API.</Description>
    <PackageReleaseNotes>
    </PackageReleaseNotes>
    <IncludeSymbols>false</IncludeSymbols>
    <PackageIcon>icon.png</PackageIcon>
    <Version>16.0.1</Version>
    <AssemblyVersion>16.0.0</AssemblyVersion>
    <PackageVersion>16.0.1</PackageVersion>
    <InformationalVersion>16.0.1</InformationalVersion>
    <Authors>Enkel Media Stockholm AB</Authors>
    <Copyright>Enkel Media Stockholm AB</Copyright>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <NoWarn>1701;1702;1591;1587;1570;1574;NU1507;NU1903;NU1902</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mailjet.Api" Version="1.2.2" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Website" Version="[16.0.0,17)" />
    <PackageReference Include="Umbraco.Cms.Api.Common" Version="[16.0.0,17)" />
    <PackageReference Include="NewsletterStudio.Core" Version="[16.0.0,17)" IncludeAssets="compile" />
    <PackageReference Include="NewsletterStudio.Web" Version="[16.0.0,17)" IncludeAssets="compile" />
  </ItemGroup>
  <ItemGroup>
    <None Include="build\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
  <Target Name="PreBuildClient_Debug" BeforeTargets="PreBuild" Condition="'$(Configuration)' == 'Debug'">
    <Message Text="Building (dev-mode), Client files in the ./Client-folder" Importance="High" />
    <!-- <Exec Command="npm install" WorkingDirectory="$(ProjectDir)Client" />
    <Exec Command="npm run build:dev" WorkingDirectory="$(ProjectDir)Client" /> -->
  </Target>
  <Target Name="PreBuildClient_Release" BeforeTargets="PreBuild" Condition="'$(Configuration)' == 'Release'">
    <Message Text="Building (release-mode), Client files in the ./Client-folder" Importance="High" />
    <Exec Command="npm install" WorkingDirectory="$(ProjectDir)Client" />
    <Exec Command="npm run build:dev" WorkingDirectory="$(ProjectDir)Client" />
  </Target>
  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Message Text="Client side code was built. Mode: $(Configuration)" Importance="High" />
  </Target>
  <!--<Target Name="RemoveLuceneAnalyzer" BeforeTargets="CoreCompile">
		<ItemGroup>
			<Analyzer Remove="@(Analyzer)" Condition="%(FileName) == 'Lucene.Net.CodeAnalysis.CSharp'" />
		</ItemGroup>
	</Target>-->
</Project>