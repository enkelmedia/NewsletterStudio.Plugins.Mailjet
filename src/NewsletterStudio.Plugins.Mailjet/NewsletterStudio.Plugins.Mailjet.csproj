<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <ContentTargetFolders>.</ContentTargetFolders>
    <PackageId>NewsletterStudio.Plugins.Mailjet</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://www.newsletterstudio.org</PackageProjectUrl>
    <PackageTags>umbraco umbraco-marketplace newsletter-studio transactional mailjet</PackageTags>
    <Description>Plugin for Newsletter Studio to send emails via the Mailjet API.</Description>
    <PackageReleaseNotes>
    </PackageReleaseNotes>
    <IncludeSymbols>false</IncludeSymbols>
    <PackageIcon>icon.png</PackageIcon>
    <Authors>Enkel Media Stockholm AB</Authors>
    <Copyright>Enkel Media Stockholm AB</Copyright>
    <!-- Generate documentation -->
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <!-- PDBs beside DLLs -->
    <DebugType>portable</DebugType>
    <!-- Publish symbols as a separate .snupkg -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Make SourceLink work + deterministic CI build -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RepositoryUrl>https://github.com/enkelmedia/NewsletterStudio.Plugins.Mailjet</RepositoryUrl>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <Version>17.0.0</Version>
    <AssemblyVersion>17.0.0</AssemblyVersion>
    <PackageVersion>17.0.0</PackageVersion>
    <InformationalVersion>17.0.0</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mailjet.Api" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Website" />
    <PackageReference Include="Umbraco.Cms.Api.Common" />
    <PackageReference Include="NewsletterStudio.Core" IncludeAssets="compile" />
    <PackageReference Include="NewsletterStudio.Web" IncludeAssets="compile" />
  </ItemGroup>
  <ItemGroup>
    <None Include="build\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
  <Target Name="PreBuildClient_Debug" BeforeTargets="PreBuild" Condition="'$(Configuration)' == 'Debug'">
    <Message Text="Building (dev-mode), Client files in the ./Client-folder" Importance="High" />
    <!-- <Exec Command="npm install" WorkingDirectory="$(ProjectDir)Client" />
    <Exec Command="npm run build:dev" WorkingDirectory="$(ProjectDir)Client" /> -->
  </Target>
  <Target Name="PreBuildClient_Release" BeforeTargets="PreBuild" Condition="'$(Configuration)' == 'Release'">
    <Message Text="Building (release-mode), Client files in the ./Client-folder" Importance="High" />
    <Exec Command="npm install" WorkingDirectory="$(ProjectDir)Client" />
    <Exec Command="npm run build:dev" WorkingDirectory="$(ProjectDir)Client" />
  </Target>
  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Message Text="Client side code was built. Mode: $(Configuration)" Importance="High" />
  </Target>
  <!--<Target Name="RemoveLuceneAnalyzer" BeforeTargets="CoreCompile">
		<ItemGroup>
			<Analyzer Remove="@(Analyzer)" Condition="%(FileName) == 'Lucene.Net.CodeAnalysis.CSharp'" />
		</ItemGroup>
	</Target>-->
</Project>